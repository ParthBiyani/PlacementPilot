# PlacementPilot — copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# Note: only the values below live here. Every API key (Anthropic, Discord,
# JSearch, SerpApi, …) goes in the n8n credential store instead — not in this
# file, not in workflow JSON, not in git. See CLAUDE.md "Conventions".

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=placementpilot
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=placementpilot

# --- n8n ----------------------------------------------------------------------
# Encrypts the credential store. Generate once and keep it safe:
#   openssl rand -hex 32
# Losing this makes every stored credential unreadable.
N8N_ENCRYPTION_KEY=

# Public base URL n8n advertises for webhooks. Needed from Phase 5 (Discord
# interactions). With Cloudflare Tunnel this is your tunnel hostname.
# Leave as localhost until then.
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PROTOCOL=http

TZ=Asia/Kolkata

# --- Config source ------------------------------------------------------------
# Where WF-L0 fetches config/*.json from. Point this at YOUR fork's raw URL.
# Any HTTPS host works — a Gist, an S3 object, anything that serves JSON.
# Edit a config file, push, and the next run picks it up.
PP_CONFIG_BASE_URL=https://raw.githubusercontent.com/ParthBiyani/PlacementPilot/main/config
