    {
      "id": "c12face1-4f77-48b7-984d-4b9813adb902",
      "name": "Diff Against Expected",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fixtures = $('Get Fixtures').all();\nconst actuals = $input.all();\n\nconst results = [];\nfor (let i = 0; i < fixtures.length; i++) {\n  const fixture = fixtures[i].json;\n  const actual = (actuals[i] && actuals[i].json) || {};\n  const expected = fixture.expected || {};\n  const mismatches = [];\n  for (const key of Object.keys(expected)) {\n    if (actual[key] !== expected[key]) {\n      mismatches.push({ field: key, expected: expected[key], actual: actual[key] });\n    }\n  }\n  results.push({\n    json: {\n      fixture_id: fixture.id,\n      kind: fixture.kind,\n      pass: mismatches.length === 0,\n      mismatches\n    }\n  });\n}\nreturn results;"
      }
    },
    {
      "id": "6b01ce92-ff17-45bd-ab0d-76eb7479406e",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const results = $input.all().map(i => i.json);\nconst total = results.length;\nconst passed = results.filter(r => r.pass).length;\nconst failed = total - passed;\nconst failures = results.filter(r => !r.pass);\n\nreturn [{\n  json: {\n    total,\n    passed,\n    failed,\n    failures,\n    all_passed: failed === 0,\n    error_text: failed > 0 ? JSON.stringify(failures) : null\n  }\n}];"
      }
    },
    {
      "id": "e62b5e01-82df-4003-906f-4dc974331d22",
      "name": "Write Run",
      "type": "n8n-nodes-base.postgres",
