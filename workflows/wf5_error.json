    {
      "id": "5e11a1a2-0001-4000-8000-000000000003",
      "name": "From Error Trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst execution = item.execution || {};\nconst trigger = item.trigger || {};\nconst err = execution.error || trigger.error || {};\nconst workflow = item.workflow || {};\n\nconst message = err.message || err.description || (err.context && err.context.description) || null;\n\nreturn [{\n  json: {\n    workflow_name: workflow.name || 'unknown workflow',\n    error_message: message || ('Unrecognized error shape: ' + JSON.stringify(err).slice(0, 500)),\n    last_node: execution.lastNodeExecuted || null,\n    execution_url: execution.url || null\n  }\n}];"
      }
    },
    {
      "id": "5e11a1a2-0001-4000-8000-000000000004",
      "name": "From Explicit Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\n\nreturn [{\n  json: {\n    workflow_name: item.workflow_name || 'unknown workflow',\n    error_message: item.error_message || 'Unspecified alarm (no error_message provided)',\n    last_node: item.last_node || null,\n    execution_url: item.execution_url || null\n  }\n}];"
      }
    },
    {
      "id": "5e11a1a2-0001-4000-8000-000000000005",
      "name": "Build Alarm Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $json;\nconst detailLines = [j.error_message || 'Unknown error'];\nif (j.last_node) detailLines.push(`Node: ${j.last_node}`);\nif (j.execution_url) detailLines.push(`Execution: ${j.execution_url}`);\nconst fullText = detailLines.join('\\n');\n\nreturn [{\n  json: {\n    workflow_name: j.workflow_name,\n    title: `\\u{1F6A8} ${j.workflow_name} failed`,\n    description: fullText,\n    db_error_text: fullText\n  }\n}];"
      }
    },
    {
