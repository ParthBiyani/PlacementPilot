      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cap = $('Is Cap Tripped?').first().json;\nconst text = `Today's Anthropic spend ($${cap.spend_today.toFixed(2)}) crossed the $${cap.cap.toFixed(2)}/day cap. WF-1, WF-1b, WF-1c, WF-1d and WF-4 have all been automatically deactivated -- no further external polling or LLM spend will occur. Review runs.cost_usd for today, then manually reactivate once you're satisfied it's safe.`;\nreturn [{\n  json: {\n    workflow_name: 'WF-5 spend cap',\n    title: '\\u{1F6D1} Daily spend cap tripped -- collectors auto-deactivated',\n    description: text,\n    db_error_text: text\n  }\n}];"
      }
    },
