    {
      "id": "5e11a1a2-0001-4000-8000-000000000009",
      "name": "Get Spend And WF-1 State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        420,
        700
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT COALESCE(SUM(cost_usd),0) FROM runs WHERE started_at::date = CURRENT_DATE) AS spend_today, (SELECT active FROM n8n.workflow_entity WHERE id = '75a4a1a8497c48f0') AS wf1_active"
      },
      "credentials": {
        "postgres": {
          "id": "pp-local-postgres",
          "name": "Local Postgres"
        }
      }
    },
    {
      "id": "5e11a1a2-0001-4000-8000-00000000000a",
      "name": "Is Cap Tripped?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json;\n// Daily Anthropic spend cap in USD -- adjust here if the estimated steady-state\n// volume (see DECISIONS.md) changes materially. Checked hourly, so this is a\n// backstop against a runaway bug, not a hard real-time limiter.\nconst CAP_USD = 5.0;\nconst spend = parseFloat(j.spend_today || 0);\nconst wf1Active = j.wf1_active === true || j.wf1_active === 't';\nreturn [{ json: { spend_today: spend, cap: CAP_USD, should_trip: spend > CAP_USD && wf1Active } }];"
      }
    },
    {
      "id": "5e11a1a2-0001-4000-8000-00000000000b",
      "name": "Cap Tripped?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        860,
        700
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.should_trip }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      }
    },
