{
  "id": "8e45da373fd94a90",
  "name": "WF-L0 lib-config",
  "nodes": [
    {
      "id": "c8ec4f55-0f13-4c22-92e0-47359b3998f7",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "6ca2be2e-c597-496f-82f7-4d1fb876a6b7",
      "name": "Get Cached",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS file, cc.etag AS cached_etag, cc.body AS cached_body FROM (SELECT 1) AS dummy LEFT JOIN config_cache cc ON cc.file = $1",
        "additionalFields": {
          "queryParams": "file"
        }
      },
      "credentials": {
        "postgres": {
          "id": "pp-local-postgres",
          "name": "Local Postgres"
        }
      }
    },
    {
      "id": "83f4669a-416b-465d-9f35-9ede0d76c159",
      "name": "Fetch Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "requestMethod": "GET",
        "url": "={{ $env.PP_CONFIG_BASE_URL }}/{{ $json.file }}",
        "responseFormat": "string",
        "dataPropertyName": "data",
        "jsonParameters": true,
        "headerParametersJson": "={{ $json.cached_etag ? JSON.stringify({ \"If-None-Match\": $json.cached_etag }) : \"{}\" }}",
        "options": {
          "fullResponse": true,
          "ignoreResponseCode": true,
          "timeout": 10000
        }
      }
    },
    {
      "id": "5734cf19-8b10-4f87-a61d-b05eeb9fc7a7",
      "name": "Decide Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const resp = $input.first().json;\nconst cached = $('Get Cached').item.json;\nconst file = cached.file;\n\nlet outcome, config, new_etag = null;\n\nif (resp.statusCode === 200) {\n  try {\n    // Field name depends on the server's Content-Type, not on responseFormat:\n    // n8n auto-parses a JSON-looking text/plain body into an object under\n    // dataPropertyName ('data') instead of leaving it as a string under 'body'.\n    const raw = resp.body !== undefined ? resp.body : resp.data;\n    config = typeof raw === 'string' ? JSON.parse(raw) : raw;\n    if (config === undefined || config === null) throw new Error('empty response body');\n    outcome = 'fresh';\n    const headers = resp.headers || {};\n    new_etag = headers.etag || headers.ETag || null;\n  } catch (e) {\n    // 200 but not valid JSON -- treat exactly like a fetch failure\n    if (cached.cached_body) {\n      outcome = 'fallback_alarm';\n      config = cached.cached_body;\n    } else {\n      outcome = 'hard_fail_alarm';\n      config = null;\n    }\n  }\n} else if (resp.statusCode === 304) {\n  outcome = 'cached_not_modified';\n  config = cached.cached_body;\n} else if (cached.cached_body) {\n  outcome = 'fallback_alarm';\n  config = cached.cached_body;\n} else {\n  outcome = 'hard_fail_alarm';\n  config = null;\n}\n\nreturn [{ json: { file, config, outcome, new_etag, statusCode: resp.statusCode || null } }];"
      }
    },
    {
      "id": "3521b878-e6dd-48b8-a260-9ca56a6648fc",
      "name": "Is Fresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.outcome }}",
              "operation": "equal",
              "value2": "fresh"
            }
          ]
        }
      }
    },
    {
      "id": "6c1e00a4-ab6c-4199-8341-64f43629acec",
      "name": "Upsert Cache",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO config_cache (file, etag, body, fetched_at, last_good_at) VALUES ($1, $2, $3, now(), now()) ON CONFLICT (file) DO UPDATE SET etag = EXCLUDED.etag, body = EXCLUDED.body, fetched_at = now(), last_good_at = now() RETURNING file",
        "additionalFields": {
          "queryParams": "file,new_etag,config"
        }
      },
      "credentials": {
        "postgres": {
          "id": "pp-local-postgres",
          "name": "Local Postgres"
        }
      }
    },
    {
      "id": "e03258e6-3242-458b-bed4-f338e22dcc09",
      "name": "Finalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const decided = $('Decide Outcome').all()[0].json;\n\nif (decided.outcome === 'hard_fail_alarm') {\n  throw new Error('WF-L0: config fetch failed for ' + decided.file + ' and no cached fallback exists');\n}\n\nreturn [{ json: { file: decided.file, config: decided.config, outcome: decided.outcome } }];"
      }
    },
    {
      "id": "a1b2c3d4-8888-4e99-cf00-1111bbbbcccc",
      "name": "Is Fallback Alarm?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1100,
        560
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.outcome }}",
              "operation": "equal",
              "value2": "fallback_alarm"
            }
          ]
        }
      }
    },
    {
      "id": "b2c3d4e5-9999-4f00-d011-2222ccccdddd",
      "name": "Build Fallback Alarm Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json;\nreturn [{\n  json: {\n    workflow_name: 'WF-L0 lib-config',\n    error_message: 'Config fetch failed for ' + j.file + ' -- serving last-good cached copy from a previous fetch instead of failing the caller',\n    last_node: 'Fetch Config',\n    execution_url: null\n  }\n}];"
      }
    },
    {
      "id": "c3d4e5f6-0000-4011-e122-3333ddddeeee",
      "name": "Call WF-5 (fallback alarm)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1540,
        560
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "5e11a1a2b3c4d5e6",
          "mode": "id"
        },
        "mode": "once"
      }
    },
    {
      "id": "d4e5f607-1111-4022-f233-4444eeeeffff",
      "name": "Restore Payload After Alarm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Call WF-5's own return value is irrelevant here -- it's a side effect\n// (sends the alarm). Re-emit the real Decide Outcome payload so the caller\n// still gets valid config data, not WF-5's response shape.\nreturn $('Decide Outcome').all();"
      }
    },
    {
      "id": "e5f60718-2222-4033-0344-5555ffff0000",
      "name": "Merge Before Finalize",
