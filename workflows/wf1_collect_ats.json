      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const result = $input.first().json;\nconst config = result.config || {};\nconst entries = config.ats || [];\n\nreturn entries.map(e => ({\n  json: {\n    id: e.provider + ':' + e.token,\n    provider: e.provider,\n    token: e.token,\n    company: e.company\n  }\n}));"
      }
    },
