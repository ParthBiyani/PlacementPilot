      "position": [
        1080,
        500
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sources (id, kind, provider, company, config, poll_tier, origin, active) VALUES ($1, 'ats', $2, $3, jsonb_build_object('token', $4), 'hourly', 'manual', true) ON CONFLICT (id) DO UPDATE SET company = EXCLUDED.company, config = EXCLUDED.config, active = true RETURNING id",
        "additionalFields": {
          "queryParams": "id,provider,company,token"
        }
