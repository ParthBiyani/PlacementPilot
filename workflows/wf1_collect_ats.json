        "query": "INSERT INTO runs (workflow, source_id, started_at, finished_at, fetched, new_count, deduped) VALUES ('WF-1', $1, now(), now(), $2, $3, $4) RETURNING id",
        "additionalFields": {
          "queryParams": "provider,fetched,new_count,deduped"
        }
      },
      "credentials": {
        "postgres": {
          "id": "pp-local-postgres",
