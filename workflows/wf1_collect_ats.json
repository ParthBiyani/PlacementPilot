    {
      "id": "d72162da-e14c-4221-9e01-809d54c298c0",
      "name": "Fetch Greenhouse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1740,
        260
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "parameters": {
        "requestMethod": "GET",
        "url": "=https://boards-api.greenhouse.io/v1/boards/{{ $json.token }}/jobs?content=true",
        "responseFormat": "string",
        "dataPropertyName": "data",
        "jsonParameters": true,
        "options": {
          "fullResponse": true,
          "ignoreResponseCode": true,
          "timeout": 15000
        }
      }
    },
    {
      "id": "f3a42047-a931-4841-92d6-8afad606a15c",
      "name": "Parse Greenhouse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        260
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "function stripHtml(html) {\n  if (!html) return '';\n  let s = html;\n  s = s.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&amp;/g, '&');\n  s = s.replace(/<[^>]+>/g, ' ');\n  s = s.replace(/&nbsp;/g, ' ');\n  return s.replace(/\\s+/g, ' ').trim();\n}\n\nconst source = $('Get Active ATS Sources').item.json;\nconst resp = $input.item.json;\n\nif (resp.statusCode !== 200) {\n  return { json: { source_id: source.id, company: source.company, provider: 'greenhouse', fetch_failed: true, statusCode: resp.statusCode, postings: [] } };\n}\n\nlet data;\ntry {\n  const raw = resp.body !== undefined ? resp.body : resp.data;\n  data = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return { json: { source_id: source.id, company: source.company, provider: 'greenhouse', fetch_failed: true, parse_error: true, postings: [] } };\n}\n\nconst jobs = data.jobs || [];\nconst postings = jobs.map(j => ({\n  company: source.company,\n  role: j.title,\n  location: (j.location && j.location.name) || null,\n  employment_type: null,\n  apply_url: j.absolute_url,\n  source: 'greenhouse',\n  source_id: source.id,\n  description: stripHtml(j.content),\n  posted_date: j.updated_at || null\n}));\n\nreturn { json: { source_id: source.id, company: source.company, provider: 'greenhouse', postings } };\n"
      }
    },
    {
      "id": "c7aa8708-fd55-4a56-a74f-543227eb32c8",
      "name": "Split Greenhouse Postings",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        2180,
        260
      ],
      "parameters": {
        "fieldToSplitOut": "postings",
        "include": "noOtherFields"
      }
    },
    {
      "id": "82e910e3-bd5d-4aa9-99f0-7e52acebae4b",
      "name": "Fetch Lever",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1740,
        500
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "parameters": {
        "requestMethod": "GET",
        "url": "=https://api.lever.co/v0/postings/{{ $json.token }}?mode=json",
        "responseFormat": "string",
        "dataPropertyName": "data",
        "jsonParameters": true,
        "options": {
          "fullResponse": true,
          "ignoreResponseCode": true,
          "timeout": 15000
        }
      }
    },
    {
      "id": "1b123316-423e-4981-bab7-61a2c8352f92",
      "name": "Parse Lever",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "function mapCommitment(c) {\n  if (!c) return null;\n  const s = c.toLowerCase();\n  if (s.includes('intern')) return 'internship';\n  if (s.includes('full')) return 'full_time';\n  if (s.includes('part')) return 'part_time';\n  if (s.includes('contract')) return 'contract';\n  return s.replace(/\\s+/g, '_');\n}\n\nconst source = $('Get Active ATS Sources').item.json;\nconst resp = $input.item.json;\n\nif (resp.statusCode !== 200) {\n  return { json: { source_id: source.id, company: source.company, provider: 'lever', fetch_failed: true, statusCode: resp.statusCode, postings: [] } };\n}\n\nlet jobs;\ntry {\n  const raw = resp.body !== undefined ? resp.body : resp.data;\n  jobs = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return { json: { source_id: source.id, company: source.company, provider: 'lever', fetch_failed: true, parse_error: true, postings: [] } };\n}\nif (!Array.isArray(jobs)) jobs = [];\n\nconst postings = jobs.map(j => ({\n  company: source.company,\n  role: j.text,\n  location: (j.categories && j.categories.location) || null,\n  employment_type: mapCommitment(j.categories && j.categories.commitment),\n  apply_url: j.hostedUrl || j.applyUrl,\n  source: 'lever',\n  source_id: source.id,\n  description: (j.descriptionPlain || '').replace(/\\s+/g, ' ').trim(),\n  posted_date: j.createdAt ? new Date(j.createdAt).toISOString() : null\n}));\n\nreturn { json: { source_id: source.id, company: source.company, provider: 'lever', postings } };\n"
      }
    },
    {
      "id": "ff9b0246-1d3e-4fe2-b138-a29dfd9e955a",
      "name": "Split Lever Postings",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        2180,
        500
      ],
      "parameters": {
        "fieldToSplitOut": "postings",
        "include": "noOtherFields"
      }
    },
    {
      "id": "e332da2f-f818-416d-9346-894ea66de043",
      "name": "Fetch Ashby",
      "type": "n8n-nodes-base.httpRequest",
