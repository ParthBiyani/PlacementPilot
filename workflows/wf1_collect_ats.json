    {
      "id": "8acef31f-70a0-44e0-a290-ef6df770e0c2",
      "name": "Parse Ashby",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        740
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "function mapEmploymentType(t) {\n  if (!t) return null;\n  const map = { FullTime: 'full_time', PartTime: 'part_time', Intern: 'internship', Contract: 'contract', Temporary: 'contract' };\n  return map[t] || t.toLowerCase();\n}\n\nconst source = $('Get Active ATS Sources').item.json;\nconst resp = $input.item.json;\n\nif (resp.statusCode !== 200) {\n  return { json: { source_id: source.id, company: source.company, provider: 'ashby', fetch_failed: true, statusCode: resp.statusCode, postings: [] } };\n}\n\nlet data;\ntry {\n  const raw = resp.body !== undefined ? resp.body : resp.data;\n  data = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return { json: { source_id: source.id, company: source.company, provider: 'ashby', fetch_failed: true, parse_error: true, postings: [] } };\n}\n\nconst jobs = data.jobs || [];\nconst postings = jobs.map(j => ({\n  company: source.company,\n  role: j.title,\n  location: j.location || null,\n  employment_type: mapEmploymentType(j.employmentType),\n  apply_url: j.jobUrl || j.applyUrl,\n  source: 'ashby',\n  source_id: source.id,\n  description: (j.descriptionPlain || '').replace(/\\s+/g, ' ').trim(),\n  posted_date: j.publishedAt || null\n}));\n\nreturn { json: { source_id: source.id, company: source.company, provider: 'ashby', postings } };\n"
      }
    },
    {
      "id": "c7858cf5-a5e4-4fbb-bc6e-000c2adaddb4",
      "name": "Split Ashby Postings",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        2180,
